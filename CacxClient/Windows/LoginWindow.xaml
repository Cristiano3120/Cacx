<UserControl x:Class="CacxClient.Windows.LoginWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CacxClient.Windows"
             xmlns:custom="clr-namespace:CacxClient.CustomUserControls"
             xmlns:loc="clr-namespace:Cacx.LanguageManager.Wpf;assembly=Cacx.LanguageManager.Wpf"
             xmlns:vm="clr-namespace:CacxClient.MVVM"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
             d:DesignHeight="450" d:DesignWidth="800" 
             d:MinHeight="450" d:MinWidth="800"
             d:MaxHeight="450" d:MaxWidth="800"
             Width="800" Height="450"
             MinWidth="800" MinHeight="450"
             MaxWidth="800" MaxHeight="450">
    <Grid>
        <TextBlock x:Name="InformationTextBlock" Text="This is an error" VerticalAlignment="Top" HorizontalAlignment="Center" 
                   Margin="0, 150, 0, 0" Visibility="Hidden"/>

        <custom:ImprovedTextBox x:Name="EmailTextBox" Height="35" Width="200" Label="{loc:Localization EmailLabel}" 
                                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
        <custom:ImprovedTextBox x:Name="PasswordTextBox" Height="35" Width="200" Label="{loc:Localization PasswordLabel}" 
                                Margin="0, 150, 0, 0" Text="{Binding Password, Mode=OneWayToSource}"/>

        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0, 205, 0, 0">
            <Hyperlink x:Name="CreateAccHyperlink" Command="{Binding SwitchToRegisterCommand}">
                <TextBlock Text="{loc:Localization CreateAccHyperlink}"/>
            </Hyperlink>
        </TextBlock>

        <Button x:Name="LoginBtn" MinWidth="65" Height="30" Padding="5, 0"
            VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0, 0, 0, 50" 
            Content="{loc:Localization LoginBtn}"
            Command="{Binding LoginCommand}" IsEnabled="{Binding LoginBtnEnabled}"/>
    </Grid>
</UserControl>
