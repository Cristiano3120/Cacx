<UserControl x:Class="CacxClient.CustomUserControls.ImprovedTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CacxClient.CustomUserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Duration x:Key="DurationValue">0:0:0.2</Duration>
    </UserControl.Resources>

    <Grid>
        <TextBox x:Name="InnerTextBox" 
             Width="{Binding Width, RelativeSource={RelativeSource AncestorType=UserControl}}"
             Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}"
             MaxLength="{Binding MaxTextLength, RelativeSource={RelativeSource AncestorType=UserControl}}"
             Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
             AcceptsReturn="{Binding AcceptsReturn, RelativeSource={RelativeSource AncestorType=UserControl}}"
             TextWrapping="{Binding TextWrapping, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <TextBlock x:Name="InnerTextBlock" Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Margin="3,0,0,0"
                   VerticalAlignment="Top"
                   RenderTransformOrigin="0,0"
                   Style="{StaticResource BaseTextBlockStyle}">
        </TextBlock>
    </Grid>
</UserControl>
