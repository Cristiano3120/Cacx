<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--############################-->
    <!--      SURFACE BRUSHES       -->
    <!--############################-->

    <SolidColorBrush x:Key="WindowBackgroundColorBrush" Color="{DynamicResource WindowBackgroundColor}" /> 
    <SolidColorBrush x:Key="PanelBackgroundColorBrush" Color="{DynamicResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="InputBackgroundColorBrush" Color="{DynamicResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />

    <!--############################-->
    <!--      TEXT BRUSHES       -->
    <!--############################-->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="{DynamicResource BorderPrimaryColor}"/>
</ResourceDictionary>