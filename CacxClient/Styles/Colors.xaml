<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- BACKGROUND / SURFACES -->
    <Color x:Key="WindowBackgroundColor">#1f1e1f</Color>
    <Color x:Key="PanelBackgroundColor">#1f1e1f</Color> <!--Panels-->
    <Color x:Key="InputBackgroundColor">#2e2d2e</Color> <!--Inputs-->
    <Color x:Key="HoverColor">#cccccc</Color> <!--Hover-->

    <!-- TEXT-->
    <Color x:Key="TextPrimaryColor">Black</Color>
    <Color x:Key="TextErrorColor">Red</Color>
    
    <!-- BORDERS -->
    <Color x:Key="BorderPrimaryColor">#1a191a</Color>
</ResourceDictionary>