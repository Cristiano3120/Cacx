<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Thickness x:Key="TextBox_BorderThickness" Left="2" Top="2" Right="2" Bottom="2"/>
    <Thickness x:Key="TextBox_Padding" Left="0" Top="5" Right="0" Bottom="0"/>
    <FontWeight x:Key="TextBox_FontWeight">SemiBold</FontWeight>
    <CornerRadius x:Key="TextBox_CornerRadius">8</CornerRadius>


    <Style TargetType="TextBox" x:Key="BaseTextBoxStyle">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />

        <Setter Property="Foreground">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" />
            </Setter.Value>
        </Setter>

        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource BorderPrimary}" />
            </Setter.Value>
        </Setter>

        <Setter Property="FontWeight" Value="{StaticResource TextBox_FontWeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize_Small}" />
        <Setter Property="Padding" Value="{StaticResource TextBox_Padding}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                        BorderThickness="{StaticResource TextBox_BorderThickness}"
                        CornerRadius="{StaticResource TextBox_CornerRadius}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(TextBox.Foreground).(SolidColorBrush.Color)"
                                                    To="{StaticResource HoverColor}"
                                                    Duration="0:0:0.3" />

                                        <ColorAnimation Storyboard.TargetName="Border"
                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    To="{StaticResource HoverColor}"
                                                    Duration="0:0:0.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(TextBox.Foreground).(SolidColorBrush.Color)"
                                                    To="{StaticResource TextPrimaryColor}"
                                                    Duration="0:0:0.2" />

                                        <ColorAnimation Storyboard.TargetName="Border"
                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    To="{StaticResource BorderPrimary}"
                                                    Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxStyle}"/>
</ResourceDictionary>