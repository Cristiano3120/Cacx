<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CacxClient.CustomUserControls">

    <Thickness x:Key="TextBox_BorderThickness" Left="2" Top="2" Right="2" Bottom="2"/>
    <Thickness x:Key="TextBox_Padding" Left="0" Top="5" Right="0" Bottom="0"/>
    <FontWeight x:Key="TextBox_FontWeight">SemiBold</FontWeight>
    <CornerRadius x:Key="TextBox_CornerRadius">8</CornerRadius>


    <Style TargetType="TextBox" x:Key="BaseTextBoxStyle">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundColorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}"/>
        <Setter Property="FontWeight" Value="{StaticResource TextBox_FontWeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize_Small}" />
        <Setter Property="Padding" Value="{StaticResource TextBox_Padding}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                        BorderThickness="{StaticResource TextBox_BorderThickness}"
                        CornerRadius="{StaticResource TextBox_CornerRadius}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxStyle}"/>
</ResourceDictionary>