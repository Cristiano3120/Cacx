<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Thickness x:Key="Button_BorderThickness" Left="2" Top="2" Right="2" Bottom="2"/>
    <CornerRadius x:Key="Button_CornerRadius" TopLeft="8" TopRight="8" BottomRight="8" BottomLeft="8"/>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" 
                        BorderThickness="{StaticResource Button_BorderThickness}"
                        BorderBrush="{DynamicResource PrimaryBorderBrush}"
                        CornerRadius="{StaticResource Button_CornerRadius}" 
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>

                        <!--Click/Bounce Animation-->
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard Storyboard="{StaticResource BounceAnimation}" HandoffBehavior="Compose"/>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!--Set the origin to x: 0.5 and y: 0.5 aka. the middle of the button-->
        <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform x:Name="btnScale" ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>